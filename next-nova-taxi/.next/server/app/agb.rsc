a:["$","$1","c",{"children":[["$","section",null,{"className":"section-padding","children":["$","div",null,{"className":"container max-w-3xl space-y-8","children":[["$","div",null,{"className":"space-y-4","children":[["$","p",null,{"className":"text-xs uppercase tracking-[0.4em] text-gray-400","children":"Rechtliches"}],["$","h1",null,{"className":"text-3xl md:text-4xl font-semibold text-white","children":"Allgemeine Geschäftsbedingungen (AGB)"}]]}],["$","div",null,{"className":"space-y-6 text-gray-300","children":[["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"1. Geltungsbereich"}],["$","p",null,{"className":"text-sm","children":"Diese Allgemeinen Geschäftsbedingungen gelten für alle Beförderungsleistungen, die von Nova Taxi (nachfolgend \"Unternehmen\") erbracht werden. Mit der Buchung einer Fahrt akzeptiert der Fahrgast diese Bedingungen."}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"2. Leistungsumfang"}],["$","p",null,{"className":"text-sm","children":"Das Unternehmen erbringt Personenbeförderungsleistungen im Rahmen des Taxigewerbes. Dazu gehören insbesondere:"}],["$","ul",null,{"className":"text-sm list-disc list-inside mt-2 space-y-1","children":[["$","li",null,{"children":"Stadtfahrten und Regionalfahrten"}],["$","li",null,{"children":"Flughafentransfers (Zürich, Basel)"}],["$","li",null,{"children":"Bahnhoftransfers"}],["$","li",null,{"children":"Geschäftsfahrten und VIP-Service"}],["$","li",null,{"children":"Kurierfahrten"}]]}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"3. Buchung und Vertragsabschluss"}],["$","p",null,{"className":"text-sm","children":"Eine Buchung kann telefonisch, per E-Mail oder WhatsApp erfolgen. Der Beförderungsvertrag kommt mit der Bestätigung der Buchung durch das Unternehmen zustande."}],["$","p",null,{"className":"text-sm mt-2","children":"Bei Vorausbuchungen ist die Angabe von Name, Telefonnummer, Abholadresse, Zielort sowie Datum und Uhrzeit erforderlich."}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"4. Preise und Zahlung"}],["$","p",null,{"className":"text-sm","children":"Die Preise richten sich nach der gefahrenen Strecke, der Tageszeit und besonderen Anforderungen. Bei Vorausbuchungen kann auf Wunsch ein Festpreis vereinbart werden."}],["$","p",null,{"className":"text-sm mt-2","children":"Akzeptierte Zahlungsmittel: Bargeld, Kreditkarten (Visa, Mastercard), Debitkarten, Twint. Firmenkunden können auf Rechnung zahlen (nach Vereinbarung)."}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"5. Stornierung und Änderung"}],["$","p",null,{"className":"text-sm","children":"Buchungen können bis zu 2 Stunden vor der geplanten Abholzeit kostenlos storniert werden. Bei späteren Stornierungen oder Nichterscheinen kann eine Aufwandsentschädigung erhoben werden."}],["$","p",null,{"className":"text-sm mt-2","children":"Änderungen der Buchung (z.B. Uhrzeit, Adresse) sind nach Möglichkeit zu berücksichtigen und sollten so früh wie möglich mitgeteilt werden."}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"6. Wartezeit"}],["$","p",null,{"className":"text-sm","children":"Bei Vorausbuchungen wartet der Fahrer bis zu 15 Minuten nach der vereinbarten Abholzeit. Bei Flughafenabholungen wird auf die effektive Ankunftszeit des Fluges gewartet (Flugüberwachung). Längere Wartezeiten können zusätzlich berechnet werden."}]]}],["$","div",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"7. Gepäck"}],["$","p",null,{"className":"text-sm","children":"Normales Reisegepäck ist im Fahrpreis inbegriffen. Sperrige oder ungewöhnlich grosse Gepäckstücke müssen bei der Buchung angegeben werden. Das Unternehmen behält sich vor, die Beförderung von Gegenständen abzulehnen, die das Fahrzeug beschädigen könnten."}]]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19"]}]}],null,"$L1a"]}]
