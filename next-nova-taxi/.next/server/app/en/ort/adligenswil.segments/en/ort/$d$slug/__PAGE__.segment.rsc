0:{"buildId":"Lij9gpsWiFPMXDL2lTdi2","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Adligenswil\",\"description\":\"Taxi Adligenswil – Ihr lokaler Taxiservice über Luzern. Familien, Pendler, Alltag. Nova Taxi 24/7 verfügbar.\",\"url\":\"https://www.nova-taxi.com/en/ort/adligenswil\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Adligenswil\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wie teuer ist ein Taxi von Adligenswil nach Luzern?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Je nach genauem Abholort etwa CHF 25-35. Für regelmässige Fahrten bieten wir Rabatte an.\"}},{\"@type\":\"Question\",\"name\":\"Fahren Sie auch zu den Weilern ausserhalb des Dorfkerns?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Selbstverständlich. Wir bedienen die gesamte Gemeinde, auch abgelegene Adressen.\"}},{\"@type\":\"Question\",\"name\":\"Haben Sie Kindersitze?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, wir haben Kindersitze verschiedener Grössen. Bitte bei der Buchung Alter und Anzahl der Kinder angeben.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich regelmässige Schulfahrten buchen?\",\"acceptedAnswer\":{\"@type\":