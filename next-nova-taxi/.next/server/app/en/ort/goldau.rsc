1b:T63a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I get from Goldau station to the Rigi railway?","acceptedAnswer":{"@type":"Answer","text":"The Arth-Rigi-Bahn station is adjacent to the main Goldau station – literally a short walk. However, if you have heavy luggage or limited mobility, we can drive you directly to the Rigi railway platform entrance."}},{"@type":"Question","name":"Can you take us to the Nature and Animal Park?","acceptedAnswer":{"@type":"Answer","text":"Yes, though the park is easily walkable from the station (about 10 minutes). We're more useful for pickup when visiting with young children who are tired after exploring."}},{"@type":"Question","name":"What's the fare from Goldau to Zurich Airport?","acceptedAnswer":{"@type":"Answer","text":"Airport transfers from Goldau typically cost CHF 140-160. We offer fixed pricing for this popular route – contact us for an exact quote based on your specific pickup point."}},{"@type":"Question","name":"Do you serve the lakeside areas near Goldau?","acceptedAnswer":{"@type":"Answer","text":"Yes, we cover the Lake Zug shore from Arth to Walchwil, and the Lake Lauerz area as well. Beach access, restaurant transport, and hotel transfers are all available."}},{"@type":"Question","name":"Is there taxi service for Rigi hikers returning to Goldau?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Hikers often descend different routes than they ascended. We can collect you from various Rigi base points and return you to Goldau station or your accommodation."}}]}13:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Goldau\",\"description\":\"Taxi Goldau – gateway to Mount Rigi and Central Switzerland. Station transfers, Nature Park, airport connections. Nova Taxi 24/7.\",\"url\":\"https://www.nova-taxi.com/en/ort/goldau\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Goldau\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","div",null,{"className":"section-padding","children":["$","div",null,{"className":"container space-y-12","children":[["$","nav",null,{"className":"text-sm text-gray-400","aria-label":"Breadcrumb","children":[["$","$Lf",null,{"href":"/en","className":"hover:text-white","children":"Home"}],["$","span",null,{"className":"mx-2","children":"›"}],["$","$Lf",null,{"href":"/en/kanton/schwyz","className":"hover:text-white","children":["Canton ","Schwyz"]}],["$","span",null,{"className":"mx-2","children":"›"}],["$","span",null,{"className":"text-white","children":"Goldau"}]]}],["$","header",null,{"className":"space-y-4 max-w-4xl","children":[["$","p",null,{"className":"text-sm uppercase tracking-[0.3em] text-nova-gold","children":"Your Starting Point for Alpine Adventures"}],["$","h1",null,{"className":"text-3xl md:text-4xl lg:text-5xl font-semibold text-white","children":"Taxi Service in Goldau"}]]}],["$","div",null,{"className":"flex flex-col sm:flex-row gap-4","children":[["$","a",null,{"href":"tel:+41766113131","className":"inline-flex items-center justify-center rounded-full bg-nova-gold px-7 py-4 text-sm font-semibold text-black hover:bg-nova-gold-soft transition-colors min-h-[48px]","data-testid":"phone-cta","children":"Book taxi: 076 611 31 31"}],"$L1c"]}],"$L1d","$L1e","$L1f"]}]}]]
1c:["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp"}]
1d:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Goldau sits at a geographical and historical crossroads. The dramatic landslide of 1806 shaped the landscape that visitors see today, while the railway junction that followed made this small community a transport hub of surprising importance."}],["$","p","1",{"children":"Nova Taxi operates from this unique position. We serve tourists bound for Rigi adventures, business travelers transferring between trains, and residents navigating daily life in a village that punches above its weight in regional significance."}],["$","p","2",{"children":"The Nature and Animal Park draws families year-round, its bears and wolves offering wildlife encounters impossible elsewhere in Switzerland. Our taxi service connects this attraction with the wider area, helping visitors explore beyond the park's boundaries."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Mount Rigi transfers anchor our tourism business. The Arth-Rigi-Bahn departs steps from the main station, but coordinating train arrivals with mountain railway connections often requires transport assistance. We bridge these gaps, ensuring visitors maximize their alpine time."}],["$","p","1",{"children":"The station's importance as a railway junction creates unique transfer needs. Cross-platform connections can be tight, and unfamiliar travelers sometimes need help navigating between services. Our presence at the station provides reassurance and practical assistance."}],["$","p","2",{"children":"Nature and Animal Park visitors represent steady business, particularly families with tired children at day's end. We transport guests to accommodations throughout the region, from lakeside hotels to mountain retreats."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Mount Rigi railway connections"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Nature and Animal Park transport"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Station transfer assistance"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport – approximately 50 minutes"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Lakeside hotel transfers"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hiking trailhead access"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":["$L20","$L21"]}],"$L22","$L23"]
