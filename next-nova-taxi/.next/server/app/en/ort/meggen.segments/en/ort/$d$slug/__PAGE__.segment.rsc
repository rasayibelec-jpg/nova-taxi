4:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Zuverlässiges Taxi in Meggen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Meggen zählt zu den begehrtesten Wohngemeinden der Zentralschweiz. Die Kombination aus direkter Seelage, Blick auf Pilatus und Rigi sowie die Nähe zu Luzern macht diesen Ort einzigartig. Entsprechend hoch sind die Ansprüche an einen lokalen Taxiservice."}],["$","p","1",{"children":"Nova Taxi erfüllt diese Erwartungen mit Professionalität und Diskretion. Unsere Fahrzeuge passen zu den gepflegten Villenquartieren von Meggen. Ob Bankdirektor mit frühem Flug oder Familie auf dem Weg zum Samstagseinkauf – wir behandeln jeden Fahrgast mit der gleichen Sorgfalt."}],["$","p","2",{"children":"Die Gemeinde erstreckt sich vom Seeufer bis zur Meggenalp. Dieser Höhenunterschied bedeutet, dass viele Wege zu steil oder zu lang für bequemes Gehen sind. Unser Taxiservice verbindet alle Höhenlagen zuverlässig miteinander."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Dienstleistungen in Meggen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Flughafentransfers gehören zu unseren häufigsten Fahrten ab Meggen. Der Flughafen Zürich erreichen wir in etwa 45 Minuten – ideal für Geschäftsreisende, die den Tag produktiv nutzen möchten. Wir holen Sie vor Ihrer Haustür ab und bringen Sie direkt zum Terminal."}],["$","p","1",{"children":"Die kurze Distanz nach Luzern macht Meggen auch für abendliche Kulturveranstaltungen attraktiv. Nach einem Konzert im KKL oder einem Theaterabend bringen wir Sie sicher nach Hause, ohne dass Sie sich um Parkplatzsuche oder den letzten Bus sorgen müssen."}],["$","p","2",{"children":"Für Bootsbesitzer bieten wir Transfers zum Megger Hafen und zu den verschiedenen Bootsanlegestellen. Auch Golfplatzfahrten zum nahegelegenen Dietschiberg gehören zu unserem Repertoire."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafen Zürich Transfer – ca. 45 Minuten"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Luzern Innenstadt und KKL Fahrten"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schulweg-Begleitung für Kinder"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hafen und Bootsanleger Transfers"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Golfplatz Dietschiberg Verbindungen"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Arztbesuche und Spitalfahrten"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":["$L8","$L9"]}],"$La","$Lb"]
5:["$","div",null,{"className":"rounded-2xl bg-nova-gold/10 border border-nova-gold/30 p-6 md:p-8","children":["$","div",null,{"className":"grid md:grid-cols-2 gap-6 items-center","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white mb-2","children":["Book a Taxi in ","Meggen"," Now"]}],["$","p",null,{"className":"text-sm text-gray-300","children":"Call us directly or send a WhatsApp message. We confirm your booking immediately."}]]}],["$","div",null,{"className":"flex flex-col gap-3","children":[["$","a",null,{"href":"tel:+41766113131","className":"inline-flex items-center justify-center rounded-full bg-nova-gold px-6 py-3 text-sm font-semibold text-black hover:bg-nova-gold-soft transition-colors","children":"076 611 31 31"}],["$","a",null,{"href":"mailto:info@nova-taxi.com","className":"inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-sm text-white hover:bg-white/10 transition-colors","children":"info@nova-taxi.com"}]]}]]}]}]
