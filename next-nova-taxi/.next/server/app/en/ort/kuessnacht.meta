    "x-next-cache-tags": "_N_T_/layout,_N_T_/en/layout,_N_T_/en/ort/layout,_N_T_/en/ort/[slug]/layout,_N_T_/en/ort/[slug]/page,_N_T_/en/ort/kuessnacht"
  },
