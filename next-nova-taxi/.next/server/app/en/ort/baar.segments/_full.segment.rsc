26:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Why Choose Us in Baar"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Baar's business community operates at international standards. This means expecting taxis with impeccable interiors, drivers who dress professionally, and service that matches what clients experience in London, Singapore, or New York."}],["$","p","1",{"children":"We've invested in meeting these expectations. Our vehicles feature leather seating, climate control, and mobile charging. Drivers receive training in professional conduct and discretion. For VIP situations, we can arrange premium vehicles."}],["$","p","2",{"children":"Beyond corporate needs, we serve Baar's diverse residential population. Young families in new developments, seniors in established neighborhoods, and everyone between – all receive the same professional treatment."}]]}]]}]
27:["$","section",null,{"className":"rounded-2xl bg-gradient-to-br from-nova-bg-soft to-black border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Getting Around in Baar"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Baar sprawls across the valley between Zug and the Albis hills. The A4 motorway bisects the municipality, providing fast regional access but also dividing neighborhoods. Our taxi service connects areas that the highway separates."}],["$","p","1",{"children":"Public transport centers on bus lines to Zug station, but coverage of Baar's expanding commercial zones varies. Many office parks lack direct bus service, making taxis essential for the last mile of business travel."}],["$","p","2",{"children":"The growing Baar-North district attracts young professionals who increasingly rely on mobility services rather than car ownership. We're adapting our service to meet this shifting demand with flexible booking options and rapid response times."}]]}]]}]
28:["$","section",null,{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white","children":["Frequently Asked Questions about Taxi ","Baar"]}],["$","div",null,{"className":"grid gap-4","children":[["$","div","0",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"How do I set up a corporate account for my Baar-based company?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Contact us directly to discuss your company's typical needs. We'll create a customized account with monthly invoicing, designated contact person, and any special requirements you have."}]]}],["$","div","1",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"What's the fastest way from Baar to Zurich Airport?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Our direct taxi route typically takes 30 minutes via the A4 motorway. We recommend allowing 45-50 minutes total to account for any traffic variations and terminal navigation."}]]}],["$","div","2",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Do you offer fixed prices for airport transfers?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Yes, we provide fixed-price airport transfers from Baar to Zurich Airport. The exact rate depends on your pickup location within Baar – contact us for a quote."}]]}],["$","div","3",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Can you pick up my clients arriving at Zug station?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Absolutely. Meet-and-greet service at Zug station includes waiting with a name sign, assistance with luggage, and transport to your Baar office or specified destination."}]]}],["$","div","4",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Is weekend service available in Baar?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Yes, we operate 24/7 including weekends. While business transport slows on weekends, we handle personal travel, airport transfers, and leisure trips throughout Baar."}]]}]]}]]}]
