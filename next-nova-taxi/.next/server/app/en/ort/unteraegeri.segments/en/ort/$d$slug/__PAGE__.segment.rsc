3:["$","p","0",{"children":"Unterägeri liegt idyllisch am Ägerisee und zieht Erholungssuchende aus der ganzen Region an. Das klare Wasser, die umliegenden Wälder und die Ruhe abseits der Grossstädte machen den Ort zu einem beliebten Ausflugs- und Wohnziel."}]
4:["$","p","1",{"children":"Nova Taxi kennt Unterägeri von der Seepromenade bis zu den Höhenlagen Richtung Morgarten. Ob Badegäste im Sommer oder Skifahrer im Winter – wir transportieren Gäste das ganze Jahr."}]
5:["$","p","2",{"children":"Die Gemeinde verbindet Naturerlebnis mit guter Erreichbarkeit. Zug und der Flughafen Zürich sind in akzeptabler Zeit erreichbar, ohne dass man auf die Vorzüge des ländlichen Lebens verzichten muss."}]
6:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Dienstleistungen in Unterägeri"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Freizeittransfers prägen unser Unterägerer Geschäft. Im Sommer bringen wir Familien zu Strandbädern und Ausflugsrestaurants. Im Winter transportieren wir Skifahrer zum nahen Sattel-Hochstuckli."}],["$","p","1",{"children":"Die Ägerital-Gemeinden – Unterägeri und Oberägeri – bilden einen zusammenhängenden Lebensraum. Wir verbinden beide Orte und die umliegenden Weiler miteinander."}],["$","p","2",{"children":"Für Pendler nach Zug und darüber hinaus bieten wir zuverlässige Anschlussfahrten. Der Bus verkehrt regelmässig, aber für individuelle Zeiten bleibt das Taxi die flexible Alternative."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Strandbad und Seepromenade Transfers"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Sattel-Hochstuckli Skigebiet"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Wanderweg-Ausgangspunkte"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafen Zürich – ca. 40 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Verbindungen nach Zug und Baar"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Morgarten Schlachtfeld Touren"}]]}]]}]]}]
7:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Nova Taxi in Unterägeri"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Unterägeri lebt von Erholung und Lebensqualität. Unser Service unterstützt diesen Anspruch – entspannte Fahrten, freundliche Fahrer, keine Hektik."}],["$","p","1",{"children":"Die saisonalen Schwankungen zwischen Sommer und Winter kennen wir aus Erfahrung. Entsprechend passen wir unsere Verfügbarkeit an die jeweiligen Bedürfnisse an."}],["$","p","2",{"children":"Familien mit Kindern schätzen unsere Flexibilität. Kindersitze, Platz für Sportausrüstung, geduldige Fahrer – wir machen Familienausflüge stressfrei."}]]}]]}]
8:["$","section",null,{"className":"rounded-2xl bg-gradient-to-br from-nova-bg-soft to-black border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Mobilität in Unterägeri"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Unterägeri erstreckt sich rund um das Seeende und hinauf in die Hanglagen. Die Buslinie aus Zug erschliesst den Ortskern gut, aber abgelegenere Gebiete sind auf individuelle Mobilität angewiesen."}],["$","p","1",{"children":"Die Strasse über den Sattel verbindet mit der Innerschweiz, kann im Winter aber anspruchsvoll sein. Unsere Fahrer kennen die Verhältnisse und fahren entsprechend vorsichtig."}],["$","p","2",{"children":"Der Nachbarort Oberägeri und die Ausflugsziele rund um den See gehören zu unserem Einzugsgebiet. Wir verbinden das ganze Ägerital."}]]}]]}]
