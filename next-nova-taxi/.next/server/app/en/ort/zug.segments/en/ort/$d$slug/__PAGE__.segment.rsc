:"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Corporate accounts with monthly billing"}]]}]]}]]}]
7:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Why Zug Clients Choose Nova Taxi"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Discretion is essential at a business location like Zug. We do not pass on customer information, drive in unobtrusive dark vehicles and appear in polite business attire."}],["$","p","1",{"children":"Multilingualism is standard. All our drivers speak fluent English, often Italian, French or Russian as well. International guests feel understood."}]]}]]}]
