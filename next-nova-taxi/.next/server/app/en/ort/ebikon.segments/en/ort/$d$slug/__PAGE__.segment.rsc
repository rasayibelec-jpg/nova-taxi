4:["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp"}]
5:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Ebikon"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Ebikon has emerged as one of the Lucerne agglomeration's most dynamic communities. The opening of Mall of Switzerland transformed the area into a regional shopping destination, while thoughtful urban development has created attractive residential neighborhoods for young families and professionals."}],["$","p","1",{"children":"Nova Taxi has grown with Ebikon's evolution. We remember when the main road was quieter and weekends slower. Now, we navigate the increased traffic with local expertise, knowing back routes and timing patterns that keep passengers moving efficiently."}],["$","p","2",{"children":"The community balances suburban convenience with urban accessibility. Lucerne's cultural offerings lie just minutes away, while green spaces and family-friendly amenities define local life. Our taxi service connects these complementary aspects of Ebikon living."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Ebikon"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Mall of Switzerland generates significant transport demand. Shoppers arrive from across Central Switzerland, but parking challenges and heavy bags make taxi service attractive. We offer dedicated shopping trip packages – drop off at the entrance, collect calls for pickup with your purchases loaded curbside."}],["$","p","1",{"children":"Commuter connections represent steady daily business. Many Ebikon residents work in Lucerne or Zug, using our taxi service for station transfers when weather discourages walking or timing is tight. The Rontal tram extension has improved public transit, but first-mile and last-mile gaps remain."}],["$","p","2",{"children":"Family transport needs fill our calendar: children to activities, grandparents to appointments, airport trips for vacation departures. We've become the flexible solution when family logistics get complicated."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Mall of Switzerland shopping transfers"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Lucerne train station connection – 10 minutes"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport – approximately 50 minutes"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"School and activity transport"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Medical appointment transfers"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],"$L9"]}]]}]]}],"$La","$Lb","$Lc"]
