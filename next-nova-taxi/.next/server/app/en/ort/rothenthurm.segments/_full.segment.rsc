22:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Rothenthurm at 920 metres"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Rothenthurm sits at around 920 metres altitude and is famous for its unique high moor area, which is under federal protection. In winter the village turns into a small ski paradise, and in summer hikers and ornithologists arrive. Nova Taxi ensures mobility in any weather."}],["$","p","1",{"children":"Our drivers know the road between Sattel, Biberbrugg and Einsiedeln intimately. We are also out daily in the Schornen, Altmatt and Biberbrugg neighbourhoods."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"What We Offer in Rothenthurm"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Skiers and snowboarders from the small Rothenthurm-Sattel ski area use us for the journey home to Schwyz, Zug or Einsiedeln. Families with sledges are also welcome."}],["$","p","1",{"children":"In summer the high moor hiking trails are a popular destination. We pick up hikers at Rothenthurm station and bring them to trailheads or huts. Birdwatchers appreciate the quiet drive to observation posts."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Rothenthurm-Sattel ski area"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",nul