21:T42e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does a journey from Rothenthurm to Zurich take?","acceptedAnswer":{"@type":"Answer","text":"About 60 to 75 minutes depending on traffic via Sattel and Pfäffikon SZ."}},{"@type":"Question","name":"Are you available even in deep snow?","acceptedAnswer":{"@type":"Answer","text":"Yes, our drivers and vehicles are winter-ready. In extreme weather we report possible delays in good time."}},{"@type":"Question","name":"Can you transport my ski equipment?","acceptedAnswer":{"@type":"Answer","text":"Of course. Skis, snowboards and sledges fit easily into our estate cars."}},{"@type":"Question","name":"Do you offer hiking transfers?","acceptedAnswer":{"@type":"Answer","text":"Yes, both in the high moor and to more distant trailheads such as the Mythen region or Hoch-Ybrig."}},{"@type":"Question","name":"What does a trip to Zurich Airport cost?","acceptedAnswer":{"@type":"Answer","text":"About 240 to 280 francs including waiting times depending on time of day."}}]}19:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Rothenthurm\",\"description\":\"Taxi Rothenthurm – Nova Taxi for trips to the high moor, the ski slope and Zurich Airport. Reliable in the mountains.\",\"url\":\"https://www.nova-taxi.com/en/ort/rothenthurm\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Rothenthurm\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\