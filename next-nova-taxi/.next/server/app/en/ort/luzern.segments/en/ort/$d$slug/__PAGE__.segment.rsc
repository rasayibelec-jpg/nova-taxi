5:["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp"}]
6:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Lucerne"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Lucerne captivates visitors with its medieval architecture, crystal-clear lake waters, and breathtaking mountain backdrop. When exploring this gem of Central Switzerland, having a dependable taxi service transforms your experience from stressful to seamless."}],["$","p","1",{"children":"Nova Taxi understands Lucerne's unique character. Whether you're arriving at the bustling train station after a scenic journey through the Alps or need quick transport from your lakeside hotel to the iconic Chapel Bridge, our drivers know every cobblestone street and hidden shortcut in this historic city."}],["$","p","2",{"children":"The city's compact old town might seem walkable, but Lucerne's steep hills and unpredictable weather make taxi service invaluable. From the waterfront promenades near the Culture and Congress Centre to the residential areas of Tribschen, we cover every corner of this vibrant Swiss destination."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Lucerne"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Our Lucerne taxi fleet operates around the clock, understanding that travel doesn't follow a 9-to-5 schedule. Early morning flights from Zurich Airport? We'll have you there with time to spare. Late-night arrival after a concert at KKL Lucerne? Our drivers wait patiently at your pickup point."}],["$","p","1",{"children":"For tourists, we offer specialized transport to Mount Pilatus, Rigi, and the Swiss Museum of Transport. Business travelers appreciate our professional service to corporate offices along Alpenquai and the business districts near Lucerne station."}],["$","p","2",{"children":"Hotel transfers represent a significant portion of our Lucerne operations. We partner with establishments ranging from boutique guesthouses in the old town to the grand hotels overlooking the lake, ensuring your guests receive consistent, courteous service."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport transfers – approximately 50 minutes direct"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Chapel Bridge and Old Town transport"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"KKL Lucerne concert and event pickup"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Mount Pilatus railway station connections"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Lake Lucerne boat pier transfers"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":["$La","$Lb"]}]]}]]}],"$Lc","$Ld","$Le"]
