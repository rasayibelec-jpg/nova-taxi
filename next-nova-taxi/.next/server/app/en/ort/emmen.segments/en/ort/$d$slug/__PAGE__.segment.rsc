3:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Emmen ist die grösste Gemeinde im Kanton Luzern – eine lebendige Mischung aus Wohnquartieren, Industrie und Gewerbe. Die Nähe zu Luzern macht den Ort für Pendler attraktiv, während die eigene Infrastruktur Selbstständigkeit garantiert."}],["$","p","1",{"children":"Nova Taxi kennt Emmen in all seinen Facetten. Vom Emmen Center über die Industrie-quartiere bis zu den ruhigeren Wohnlagen – wir navigieren sicher durch diese vielfältige Gemeinde."}],["$","p","2",{"children":"Die Verkehrslage ist strategisch: Autobahn, Buslinien und bald die verlängerte Stadtbahn verbinden Emmen mit der Region. Unser Taxi ergänzt diese Optionen für flexible, individuelle Mobilität."}]]}]
4:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Dienstleistungen in Emmen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Das Emmen Center zieht Shopper aus der ganzen Region an. Wir bieten Abhol- und Bringservice für entspanntes Einkaufen ohne Parkplatzstress."}],["$","p","1",{"children":"Industriebetriebe und Gewerbezonen generieren regelmässigen Transportbedarf. Schichtarbeiter, Kunden, Lieferanten – wir bedienen die Wirtschaft von Emmen flexibel."}],["$","p","2",{"children":"Für Familien sind wir der zuverlässige Partner im Alltag. Schulwege, Arztbesuche, Freizeitaktivitäten – Emmen hat kurze Wege, und wir machen sie noch bequemer."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Emmen Center Shopping-Transfers"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Industrie- und Gewerbezonen Service"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Emmenbrücke Anbindung"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafen Zürich – ca. 50 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Luzern Innenstadt Verbindungen"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schichtarbeiter-Fahrten"}]]}]]}]]}]
5:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Nova Taxi in Emmen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Emmen ist eine Arbeitergemeinde mit praktischen Erwartungen. Unser Preis-Leistungs-Verhältnis entspricht diesem Anspruch – fair, transparent, zuverlässig."}],["$","p","1",{"children":"Die Grösse der Gemeinde erfordert Ortskenntnis. Wir wissen, welche Quartiere wie heissen, wo Einbahnstrassen verlaufen und welche Abkürzungen funktionieren."}],["$","p","2",{"children":"Flexibilität ist in Emmen gefragt. Schichtende um 22 Uhr, Einkauf im Center am Samstag, Sonntagsausflug – wir passen uns Ihrem Lebensrhythmus an."}]]}]]}]
