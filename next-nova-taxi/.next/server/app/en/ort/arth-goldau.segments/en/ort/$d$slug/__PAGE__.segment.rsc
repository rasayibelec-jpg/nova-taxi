2:T51f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does a taxi take from Arth-Goldau to Zurich Airport?","acceptedAnswer":{"@type":"Answer","text":"The journey takes about 50 to 60 minutes depending on traffic. For international flights we recommend pickup three hours before departure."}},{"@type":"Question","name":"Do you pick me up directly at the platform in Arth-Goldau station?","acceptedAnswer":{"@type":"Answer","text":"Yes, for a small surcharge we come right to the platform. Just provide carriage number and arrival time when booking."}},{"@type":"Question","name":"What does a ride from Arth-Goldau to Tierpark Goldau cost?","acceptedAnswer":{"@type":"Answer","text":"The short journey is between 10 and 18 francs. On request we offer fixed prices and waiting times for families."}},{"@type":"Question","name":"Are you available at night?","acceptedAnswer":{"@type":"Answer","text":"Yes, Nova Taxi operates 24/7. Even at 03:00 for early flights we are reachable – please book a day in advance if possible."}},{"@type":"Question","name":"Can I book larger groups with you?","acceptedAnswer":{"@type":"Answer","text":"For groups of five or more we organise minivans or several vehicles in convoy. Please book at least twelve hours in advance."}}]}0:{"buildId":"Lij9gpsWiFPMXDL2lTdi2","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Arth-Goldau\",\"description\":\"Taxi Arth-Goldau – Nova Taxi takes you to the Rigi cogwheel railway, the train station and Zurich Airport. Available around the clock.\",\"url\":\"https://www.nova-taxi.com/en/ort/arth-goldau\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Arth-Goldau\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"Po