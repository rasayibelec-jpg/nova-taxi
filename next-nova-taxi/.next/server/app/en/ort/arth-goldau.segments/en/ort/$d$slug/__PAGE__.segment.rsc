4:["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp"}]
5:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Arth-Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Arth-Goldau is much more than a railway hub between the cantons of Schwyz, Zug and Lucerne. Anyone arriving here finds themselves at the foot of the Rigi and in a region that attracts travellers from all over the world. Nova Taxi knows every street between the train station, Tierpark Goldau and the surrounding hamlets like the back of our hand."}],["$","p","1",{"children":"Our base in Türlihof in Oberarth is only a few minutes from Goldau. That means short response times, especially for spontaneous bookings or delayed trains. Whether you wish to be welcomed off the InterCity after a long journey or driven to an early flight to Zurich, we are there for you."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Arth-Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Arth-Goldau station is one of the most important interchange hubs in Central Switzerland. We pick you up directly from the platform and bring you to hotels, conferences or private addresses. Tierpark Goldau is also served daily – ideal for family outings with prams or large groups."}],["$","p","1",{"children":"For business travellers we offer fixed contracts at fair rates. Commuters from Walchwil, Steinen or Lauerz regularly use our service for the Zurich Airport route, which is reached in around 50 minutes."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport transfers – fixed prices on request"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Arth-Goldau station – platform pickup possible"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Tierpark Goldau – family-friendly trips"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Rigi-Bahn cogwheel railway base station"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hotel transfers to Rigi and Schwyz"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Corporate accounts with monthly invoicing"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Why Choose Nova Taxi in Arth-Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"We live and work in this region. That makes the difference when roadworks divert traffic on the Axenstrasse or the Gotthard route is congested. Our drivers always choose the fastest route and communicate transparently about waiting times."}],"$L9"]}]]}],"$La","$Lb"]
