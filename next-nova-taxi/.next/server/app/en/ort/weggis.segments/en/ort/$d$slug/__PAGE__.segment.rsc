0:{"buildId":"q9HEqRaiDLhskuwZlHWpi","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Weggis\",\"description\":\"Taxi Weggis – Ihr Taxiservice an der Schweizer Riviera. Hotelabholungen, Rigi-Transfers, Flughafenfahrten. 24/7 verfügbar.\",\"url\":\"https://www.nova-taxi.com/en/ort/weggis\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Weggis\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wie komme ich vom Flughafen Zürich nach Weggis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Wir holen Sie direkt am Terminal ab. Die Fahrt dauert etwa 60 Minuten über die Autobahn und landschaftlich schöne Uferstrasse.\"}},{\"@type\":\"Question\",\"name\":\"Fahren Sie zur Rigi Kaltbad Seilbahn?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, wir bringen Sie zur Talstation in Weggis und holen Sie nach der Bergfahrt wieder ab.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich ein Taxi für einen Ausflug buchen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Selbstverständlich. Halbtages- und Ganztagestouren in der Region bieten wir zu Pauschalpreisen an.\"}},{\"@type\":\"Question\",\"name\":\"Sind Sie auch am Wochenende verfügbar?\",