artial":false}
3:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Weggis trägt den Beinamen \"Schweizer Riviera\" zu Recht. Das milde Klima lässt Palmen und Feigenbäume gedeihen, während der Vierwaldstättersee mediterranes Flair verbreitet. Kein Wunder, dass dieser Ort seit Generationen Erholungssuchende anzieht."}],["$","p","1",{"children":"Nova Taxi bedient Weggis mit dem Gespür für diese besondere Atmosphäre. Hier herrscht kein Grossstadttempo – unsere Fahrer passen sich dem entspannten Rhythmus an, ohne dabei Zuverlässigkeit zu vernachlässigen."}],["$","p","2",{"children":"Die Seilbahn Weggis-Rigi Kaltbad schwebt von hier auf die Königin der Berge. Ausflügler schätzen unseren Transfer zum Bahnhof und die Abholung nach dem Bergabenteuer."}]]}]
4:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Dienstleistungen in Weggis"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Ferienhotels und Wellness-Resorts prägen Weggis. Wir transportieren Gäste vom Flughafen Zürich direkt in ihre Unterkunft – nach der Anreise beginnt der Urlaub sofort, ohne Stress mit Mietwagen oder öffentlichen Verkehrsmitteln."}],["$","p","1",{"children":"Die Gemeinde erstreckt sich vom See hinauf in die Höhenlagen. Wanderer nutzen unseren Service, um zu Ausgangspunkten zu gelangen, die zu Fuss schwer erreichbar sind."}],["$","p","2",{"children":"Für Seminare und Firmenklausuren in den Weggiser Hotels organisieren wir Gruppentransfers. Teilnehmer aus der ganzen Schweiz erreichen so den Tagungsort entspannt."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Seilbahn Weggis-Rigi Kaltbad Transfers"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Wellness-Hotel Abholungen"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafen Zürich – ca. 60 Minuten"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Wanderausgangspunkt-Service"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Seminar- und Firmen-Shuttles"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schiffstation Verbindungen"}]]}]]}]]}]
5:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Nova Taxi in Weggis"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Weggis lebt vom Tourismus, und wir verstehen die Erwartungen der Gäste. Freundlichkeit, Sauberkeit und Flexibilität sind selbstverständlich – sie bilden das Fundament unseres Service."}],["$","p","1",{"children":"Viele unserer Fahrgäste sprechen kein Deutsch. Unsere Fahrer kommunizieren problemlos auf Englisch und helfen bei organisatorischen Fragen über den reinen Transport hinaus."}],["$","p","2",{"children":"Die Stammgäste von Weggis kehren Jahr für Jahr zurück. Manche buchen bereits vor ihrer Ankunft denselben Fahrer – ein Vertrauensbeweis, den wir mit Konstanz honorieren."}]]}]]}]
6:["$","section",null,{"className":"rounded-2xl bg-gradient-to-br from-nova-bg-soft to-black border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Mobilität in Weggis"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Weggis liegt verkehrstechnisch abseits der Hauptachsen. Das Schiff verbindet mit Luzern und dem Urnersee, der Bus fährt nach Küssnacht. Für individuelle Mobilität bleibt das Taxi die praktischste Lösung."}],["$","p","1",{"children":"Die steilen Gassen und engen Kurven der Dorfstrassen fordern ortskundige Fahrer. Wir kennen jeden Winkel und navigieren auch grosse Fahrzeuge sicher zu abgelegenen Adressen."}],["$","p","2",{"children":"Nachbarorte wie Vitznau, Gersau und Küssnacht laden zu Tagesausflügen ein. Wir verbinden Weggis mit der gesamten Rigi-Region und darüber hinaus."}]]}]]}]
