5:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Freienbach"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Freienbach municipality encompasses the dynamic business hub of Pfäffikon SZ, the traditional village of Freienbach, and the charming lakeside communities of Hurden and Wilen. This diverse landscape demands a taxi service that understands both corporate urgency and relaxed waterfront living."}],["$","p","1",{"children":"Nova Taxi has grown alongside Freienbach's remarkable economic development. The Seedamm Center, office parks, and countless international companies choose this location for its perfect balance – Zurich accessibility combined with lower tax rates and higher quality of life."}],["$","p","2",{"children":"Our drivers navigate daily between board meetings in gleaming office towers and peaceful residential streets where families have lived for generations. This versatility defines our service: equally comfortable delivering executives to presentations and grandparents to medical appointments."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Freienbach"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Corporate transfers dominate our Freienbach operations. The concentration of financial services, trading companies, and tech startups generates constant demand for professional transport. We serve arrivals at Pfäffikon SZ station, coordinate airport pickups, and facilitate meetings throughout the greater Zurich economic area."}],["$","p","1",{"children":"Zurich Airport sits just 35 minutes away, making Freienbach exceptionally convenient for international business. Our flight monitoring ensures we're waiting when your plane lands, regardless of delays. For departures, we factor in traffic patterns to guarantee timely arrival."}],["$","p","2",{"children":"Beyond business, Freienbach offers unexpected recreational opportunities. The wooden bridge to Rapperswil, Lake Zurich swimming spots, and the Nuolen wetlands attract weekend visitors. We provide transfers to these attractions for tourists and residents alike."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport transfer – 35 minutes"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Pfäffikon SZ train station service"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Corporate account programs"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Seedamm Center and business park transport"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Rapperswil wooden bridge excursions"}]]}],"$L9"]}]]}],"$La","$Lb","$Lc"]
