2:T5d5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do you offer corporate accounts for Freienbach businesses?","acceptedAnswer":{"@type":"Answer","text":"Yes, many companies in the Pfäffikon SZ area maintain accounts with us. We provide monthly invoicing, dedicated phone lines, and priority booking for account holders."}},{"@type":"Question","name":"How early should I book for Zurich Airport transfers?","acceptedAnswer":{"@type":"Answer","text":"For guaranteed availability, book 24 hours ahead for regular times. Early morning flights (before 7am) benefit from booking 2-3 days in advance."}},{"@type":"Question","name":"Can you meet clients at Pfäffikon SZ station with a name sign?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Meet-and-greet service with name display is standard for business pickups. Just provide your guest's name and train arrival time."}},{"@type":"Question","name":"What's the fare from Freienbach to Zurich city center?","acceptedAnswer":{"@type":"Answer","text":"Depending on exact pickup location and city destination, fares typically range CHF 80-120. We offer fixed pricing for frequent routes – contact us for specifics."}},{"@type":"Question","name":"Do you transport to Rapperswil Castle or the zoo?","acceptedAnswer":{"@type":"Answer","text":"Yes, tourist transfers to Rapperswil attractions are popular. The old town, castle, and Knies Kinderzoo are all frequent destinations from Freienbach."}}]}0:{"buildId":"Lij9gpsWiFPMXDL2lTdi2","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Freienbach\",\"description\":\"Taxi Freienbach and Pfäffikon SZ. Business travel, Zurich Airport transfers, Lake Zurich transport. Nova Taxi – your local partner.\",\"url\":\"https://www.nova-taxi.com/en/ort/freienbach\",\"telephone\":\"+41766113131\",\"email\":\