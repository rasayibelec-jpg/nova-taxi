2:T5fc,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where exactly can taxis drop off at Suurstoffi?","acceptedAnswer":{"@type":"Answer","text":"We use designated drop-off zones at the Suurstoffi entrance points. Our drivers know which zone works best for different campus buildings, minimizing your walk to the final destination."}},{"@type":"Question","name":"How long does it take from Rotkreuz to Zurich Airport?","acceptedAnswer":{"@type":"Answer","text":"The journey typically takes 35 minutes via the A4 motorway. We recommend booking 2.5 hours before international flight departure for comfortable timing."}},{"@type":"Question","name":"Do you offer discounts for university students?","acceptedAnswer":{"@type":"Answer","text":"Yes, we provide student rates for regular campus travel. Show a valid student ID and ask about our multi-ride packages designed for academic schedules."}},{"@type":"Question","name":"Can you help with train connections at Rotkreuz station?","acceptedAnswer":{"@type":"Answer","text":"Certainly. We can transfer you between platforms quickly when tight connections don't allow walking time, or transport you onwards if you've missed a connection."}},{"@type":"Question","name":"Is there parking at Rotkreuz where I can leave my car and take a taxi to the airport?","acceptedAnswer":{"@type":"Answer","text":"Several parking options exist near the station. We can advise on locations and pick you up directly from your parked car for airport transfers."}}]}0:{"buildId":"q9HEqRaiDLhskuwZlHWpi","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Rotkreuz\",\"description\":\"Taxi Rotkreuz – transport hub of Central Switzerland. Suurstoffi, train station, Zurich Airport. Nova Taxi for business & residents.\",\"url\":\"https://www.nova-taxi.com/en/ort/rotkreuz\",\"