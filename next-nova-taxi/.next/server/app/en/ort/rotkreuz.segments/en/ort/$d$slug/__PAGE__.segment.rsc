4:["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp"}]
5:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Reliable Taxi in Rotkreuz"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Rotkreuz has reinvented itself dramatically. Once a railway junction village, it now hosts the Suurstoffi campus – a showcase of Swiss sustainability and innovation – alongside traditional residential areas. This combination creates unique transport dynamics."}],["$","p","1",{"children":"Nova Taxi serves both faces of Rotkreuz. We transport tech workers to their open-plan offices in carbon-neutral buildings and longtime residents to the village bakery they've visited for decades. Understanding this dual character defines our approach."}],["$","p","2",{"children":"The train station remains Rotkreuz's transport heart. As the junction where lines from Lucerne, Zug, and Zurich meet, it generates constant transfer traffic. Our taxi service connects this hub with destinations throughout the municipality and beyond."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Our Services in Rotkreuz"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Suurstoffi campus transport dominates our business weekday bookings. The innovative district houses university facilities, company headquarters, and residential units in car-free zones. We drop passengers at designated points and coordinate pickups for maximum convenience."}],["$","p","1",{"children":"Students from Lucerne University of Applied Sciences form a significant passenger group. Campus locations split between Rotkreuz and other sites create intercampus travel needs. We offer student-friendly rates for these regular journeys."}],["$","p","2",{"children":"Rail connections make Rotkreuz a strategic point for regional travel. Our taxi service extends rail mobility, providing links to destinations not directly served by trains. Business travelers particularly value this connectivity for reaching meetings across Central Switzerland."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Suurstoffi campus access and transfers"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Train station connections – central hub"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"University campus transport"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Zurich Airport – approximately 35 minutes"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Cross-platform rail connection assistance"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Corporate accounts for campus businesses"}]]}]]}]]}],"$L9","$La","$Lb"]
