25:["$","p","1",{"children":"Our vehicles are regularly serviced, clean and equipped with space for luggage, bicycles or ski equipment. Payment is possible with cash, card or Twint – with no hidden surcharges."}]
26:["$","section",null,{"className":"rounded-2xl bg-gradient-to-br from-nova-bg-soft to-black border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Mobility around Arth-Goldau"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"The location between Lake Zug and Lake Lauerz makes Arth-Goldau an ideal starting point for excursions. From here you reach the centre of Schwyz in ten minutes, Brunnen on Lake Lucerne in fifteen minutes and Zug in around twenty minutes."}],["$","p","1",{"children":"We are also available at night, when public transport thins out. Concerts at the KKL Lucerne, events in the Mythen region or rides home after a restaurant visit in Brunnen – Nova Taxi gets you home safely."}]]}]]}]
27:["$","section",null,{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white","children":["Frequently Asked Questions about Taxi ","Arth-Goldau"]}],["$","div",null,{"className":"grid gap-4","children":[["$","div","0",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"How long does a taxi take from Arth-Goldau to Zurich Airport?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"The journey takes about 50 to 60 minutes depending on traffic. For international flights we recommend pickup three hours before departure."}]]}],["$","div","1",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Do you pick me up directly at the platform in Arth-Goldau station?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Yes, for a small surcharge we come right to the platform. Just provide carriage number and arrival time when booking."}]]}],["$","div","2",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"What does a ride from Arth-Goldau to Tierpark Goldau cost?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"The short journey is between 10 and 18 francs. On request we offer fixed prices and waiting times for families."}]]}],["$","div","3",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Are you available at night?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"Yes, Nova Taxi operates 24/7. Even at 03:00 for early flights we are reachable – please book a day in advance if possible."}]]}],["$","div","4",{"className":"rounded-xl bg-white/5 border border-white/10 p-5","children":[["$","h3",null,{"className":"font-medium text-white mb-2","children":"Can I book larger groups with you?"}],["$","p",null,{"className":"text-sm text-gray-400","children":"For groups of five or more we organise minivans or several vehicles in convoy. Please book at least twelve hours in advance."}]]}]]}]]}]
