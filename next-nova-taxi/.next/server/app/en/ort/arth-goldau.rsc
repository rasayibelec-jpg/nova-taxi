21:T51f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does a taxi take from Arth-Goldau to Zurich Airport?","acceptedAnswer":{"@type":"Answer","text":"The journey takes about 50 to 60 minutes depending on traffic. For international flights we recommend pickup three hours before departure."}},{"@type":"Question","name":"Do you pick me up directly at the platform in Arth-Goldau station?","acceptedAnswer":{"@type":"Answer","text":"Yes, for a small surcharge we come right to the platform. Just provide carriage number and arrival time when booking."}},{"@type":"Question","name":"What does a ride from Arth-Goldau to Tierpark Goldau cost?","acceptedAnswer":{"@type":"Answer","text":"The short journey is between 10 and 18 francs. On request we offer fixed prices and waiting times for families."}},{"@type":"Question","name":"Are you available at night?","acceptedAnswer":{"@type":"Answer","text":"Yes, Nova Taxi operates 24/7. Even at 03:00 for early flights we are reachable – please book a day in advance if possible."}},{"@type":"Question","name":"Can I book larger groups with you?","acceptedAnswer":{"@type":"Answer","text":"For groups of five or more we organise minivans or several vehicles in convoy. Please book at least twelve hours in advance."}}]}19:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Arth-Goldau\",\"description\":\"Taxi Arth-Goldau – Nova Taxi takes you to the Rigi cogwheel railway, the train station and Zurich Airport. Available around the clock.\",\"url\":\"https://www.nova-taxi.com/en/ort/arth-goldau\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Arth-Goldau\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$21"}}],["$","div",null,{"className":"section-padding","children":["$","div",null,{"className":"container space-y-12","children":[["$","nav",null,{"className":"text-sm text-gray-400","aria-label":"Breadcrumb","children":[["$","$L15",null,{"href":"/en","className":"hover:text-white","children":"Home"}],["$","span",null,{"className":"mx-2","children":"›"}],["$","$L15",null,{"href":"/en/kanton/schwyz","className":"hover:text-white","children":["Canton ","Schwyz"]}],["$","span",null,{"className":"mx-2","children":"›"}],["$","span",null,{"className":"text-white","children":"Arth-Goldau"}]]}],["$","header",null,{"className":"space-y-4 max-w-4xl","children":[["$","p",null,{"className":"text-sm uppercase tracking-[0.3em] text-nova-gold","children":"Your gateway to the Rigi region"}],["$","h1",null,{"className":"text-3xl md:text-4xl lg:text-5xl font-semibold text-white","children":"Taxi Service in Arth-Goldau"}]]}],["$","div",null,{"className":"flex flex-col sm:flex-row gap-4","children":[["$","a",null,{"href":"tel:+41766113131","className":"inline-flex items-center justify-center rounded-full bg-nova-gold px-7 py-4 text-sm font-semibold text-black hover:bg-nova-gold-soft transition-colors min-h-[48px]","data-testid":"phone-cta","children":"Book taxi: 076 611 31 31"}],["$","a",null,{"href":"https://wa.me/41766113131","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center justify-center rounded-full bg-green-600 px-7 py-4 text-sm font-semibold text-white hover:bg-green-500 transition-colors min-h-[48px]","data-testid":"whatsapp-cta","children":"WhatsApp