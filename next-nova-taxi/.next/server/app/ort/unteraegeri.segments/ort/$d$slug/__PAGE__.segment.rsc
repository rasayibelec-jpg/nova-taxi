4:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Unterägeri liegt am Nordufer des Aegerisees und ist umgeben von Wäldern und Bergen. Die ruhige Lage zieht Familien, Senioren und Erholungssuchende an. Nova Taxi sorgt dafür, dass Sie trotz ländlicher Lage mobil bleiben."}],["$","p","1",{"children":"Wir kennen die Hauptstrasse zwischen Unter- und Oberägeri sowie die Wohnquartiere Buchwald, Boden und Aegerital. Auch zur Morgartenkapelle und zur Talstation Klewenalp bringen wir Sie."}]]}]
5:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was wir in Unterägeri leisten"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Senioren nutzen uns für Spitalbesuche, Apothekentermine oder gemeinsame Ausflüge. Familien fahren mit uns zum Strandbad oder zum Skigebiet Wildspitz."}],["$","p","1",{"children":"Touristen lassen sich zur Morgartenkapelle oder zum historischen Schlachtfeld von 1315 bringen. Auch der Aegerisee mit seinen Schiffen ist ein beliebtes Ziel."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Strandbad Unterägeri"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Morgartenkapelle und Schlachtfeld"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Unterägeri – Voralpen-Express"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 50 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Krankentransporte mit Krankenkasse"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Wandertransfers Wildspitz und Zugerberg"}]]}]]}]]}]
6:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Unterägerer auf uns setzen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Wir sind verlässlich auch bei Schnee und Glatteis. Die Hügellage und die Bergstrasse können im Winter herausfordernd sein – unsere Winterreifen und Fahrer-Erfahrung garantieren Sicherheit."}],["$","p","1",{"children":"Für ältere Stammkunden bieten wir besondere Sorgfalt: Wir helfen beim Einsteigen, transportieren Rollatoren und fahren mit angepasster Geschwindigkeit."}]]}]]}]
