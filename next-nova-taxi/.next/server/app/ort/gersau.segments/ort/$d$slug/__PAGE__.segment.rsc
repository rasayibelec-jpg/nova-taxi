2:T47f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Wie lange dauert eine Fahrt von Gersau nach Luzern?","acceptedAnswer":{"@type":"Answer","text":"Etwa 35 bis 45 Minuten je nach Verkehr und Route. Im Sommer kann es an der Axenstrasse zu Verzögerungen kommen."}},{"@type":"Question","name":"Können Sie mich vom Schiffsanleger abholen?","acceptedAnswer":{"@type":"Answer","text":"Ja, wir warten gerne am Anleger Gersau auf das eintreffende SGV-Schiff."}},{"@type":"Question","name":"Bieten Sie Krankentransporte?","acceptedAnswer":{"@type":"Answer","text":"Ja, sowohl liegend als auch sitzend. Wir rechnen direkt mit der Krankenkasse ab, sofern eine Verordnung vorliegt."}},{"@type":"Question","name":"Was kostet eine Fahrt zum Flughafen Zürich?","acceptedAnswer":{"@type":"Answer","text":"Etwa 280 bis 320 Franken je nach Tageszeit und Fahrzeugklasse."}},{"@type":"Question","name":"Sind Sie auch im Winter zuverlässig?","acceptedAnswer":{"@type":"Answer","text":"Ja, unsere Fahrzeuge sind mit hochwertigen Winterreifen ausgestattet. Auch bei Schneefall fahren wir – mit angepasster Geschwindigkeit."}}]}0:{"buildId":"Lij9gpsWiFPMXDL2lTdi2","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Gersau\",\"description\":\"Taxi Gersau – Nova Taxi am Vierwaldstättersee. Fahrten zur Rigi, nach Brunnen, Luzern und zum Flughafen Zürich. Rund um die Uhr.\",\"url\":\"https://www.nova-taxi.com/ort/gersau\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Gersau\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecificatio