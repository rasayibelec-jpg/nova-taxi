1a:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Taxi in Meggen – diskret und elegant"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Meggen ist eine der wohlhabendsten Gemeinden der Schweiz und liegt am Nordufer des Vierwaldstättersees. Hier wohnen Privatpersonen, Geschäftsleute und Familien, die Wert auf Diskretion und Qualität legen. Nova Taxi entspricht genau diesem Anspruch."}],["$","p","1",{"children":"Unsere Fahrer sind unauffällig in dunkler Kleidung, fahren saubere, gepflegte Wagen und respektieren Ihre Privatsphäre absolut. Wir kennen die ruhigen Strassen rund um die St. Charles-Kirche, das Schloss Meggenhorn und das Wohngebiet Tschädigen."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Leistungen in Meggen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Privatkunden buchen uns für regelmässige Fahrten zu Geschäftsterminen, Konzerten im KKL Luzern oder zum Flughafen Zürich. Auch internationale Gäste, die Privatvillen besuchen, werden von uns abgeholt."}],["$","p","1",{"children":"Familien nutzen uns für Schulwege ins International School Lucerne oder andere Privatschulen. Auch Reittermine in nahegelegenen Stallungen oder Tennistermine im Tennisclub Meggen werden zuverlässig bedient."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Diskrete Privatfahrten und Limousinenservice"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schloss Meggenhorn und Schwesterheime"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"International School Lucerne"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 50 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Konzerte und Events im KKL Luzern"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Geschäftsfahrten mit Monatsabrechnung"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Megger Kunden uns wählen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Diskretion ist unser oberstes Gebot. Wir geben keine Auskünfte über unsere Kunden, fotografieren keine Adressen und führen keine öffentlichen Kundenlisten. Stammkunden erreichen uns über persönliche Telefonnummern."}],["$","p","1",{"children":"Unsere Fahrzeugflotte umfasst auch schwarze Limousinen für besondere Anlässe. Für Hochzeiten, Beerdigungen oder Empfänge bieten wir entsprechend dezente Wagen an."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-gradient-to-br from-nova-bg-soft to-black border border-white/10 p-6 md:p-8","children":["$L1d","$L1e"]}],"$L1f"]
