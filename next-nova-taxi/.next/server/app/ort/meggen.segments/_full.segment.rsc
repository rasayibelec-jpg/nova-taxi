19:T4a9,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Bieten Sie Limousinenservice in Meggen?","acceptedAnswer":{"@type":"Answer","text":"Ja, schwarze Limousinen mit professionellen Fahrern für Privatkunden, Hochzeiten oder Geschäftstermine."}},{"@type":"Question","name":"Wie diskret sind Ihre Fahrer?","acceptedAnswer":{"@type":"Answer","text":"Höchste Diskretion ist Standard. Wir nehmen keine Fotos, geben keine Auskünfte und führen keine öffentlichen Listen über Kunden oder Adressen."}},{"@type":"Question","name":"Was kostet eine Fahrt von Meggen zum Flughafen Zürich?","acceptedAnswer":{"@type":"Answer","text":"Etwa 220 bis 270 Franken je nach Tageszeit und Fahrzeugklasse."}},{"@type":"Question","name":"Können Sie Schulkinder regelmässig fahren?","acceptedAnswer":{"@type":"Answer","text":"Ja, mit verlässlichen Verträgen für Eltern. Unsere Fahrer sind alle gepflegt und mit Schulkindern erfahren."}},{"@type":"Question","name":"Akzeptieren Sie Privatkonten mit Monatsabrechnung?","acceptedAnswer":{"@type":"Answer","text":"Ja, für Stammkunden bieten wir massgeschneiderte Vereinbarungen mit detaillierter Kostenaufstellung."}}]}11:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"name\":\"Nova Taxi Meggen\",\"description\":\"Taxi Meggen – Nova Taxi für diskrete Privatfahrten, Hoteltransfers und Flughafenfahrten. Diskret und zuverlässig 24/7.\",\"url\":\"https://www.nova-taxi.com/ort/meggen\",\"telephone\":\"+41766113131\",\"email\":\"info@nova-taxi.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Meggen\"},\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"Nova Taxi\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Türlihof 4\",\"addressLocality\":\"Oberarth\",\"postalCode\":\"6414\",\"addressCountry\":\"CH\"},\"telephone\":\"+41766113131\",\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification