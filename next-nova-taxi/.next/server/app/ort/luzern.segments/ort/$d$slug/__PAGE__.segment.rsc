4:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Taxi in Luzern – schnell vom Bahnhof bis zur Altstadt"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Luzern fasziniert mit der Kapellbrücke, dem Vierwaldstättersee und den umliegenden Bergen. Doch wer mit Gepäck oder bei Regen unterwegs ist, weiss: Eine zuverlässige Taxiverbindung macht den Unterschied. Nova Taxi bringt Sie in jede Ecke der Stadt – von der Altstadt über Tribschen bis nach Würzenbach."}],["$","p","1",{"children":"Unsere Fahrer kennen die kleinsten Gassen genauso wie die Hauptverkehrsadern. Bei Veranstaltungen im KKL Luzern, am Lucerne Festival oder während der Fasnacht wissen wir, welche Routen frei sind und welche gesperrt werden."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Leistungen in Luzern"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Hotels, Restaurants und Konferenzzentren sind unsere täglichen Anlaufpunkte. Wir kooperieren mit zahlreichen Häusern in Luzern und bieten ihren Gästen besondere Tarife. Auch Bahnhof- und Flughafentransfers gehören zum Standardprogramm."}],["$","p","1",{"children":"Touristen führen wir gerne zu Ausflugszielen wie Pilatus, Rigi oder dem Verkehrshaus. Geschäftsreisende profitieren von unseren Festpreisen für Strecken in die Wirtschaftsregion Zug oder Zürich."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Luzern und KKL – direkter Service"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Pilatus-Talstation Kriens und Alpnachstad"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Verkehrshaus Luzern und Tribschen"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 50 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hoteltransfers in der ganzen Innenstadt"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Fasnacht und Lucerne Festival – Sondertarife"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Luzerner Gäste uns wählen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Mehrsprachigkeit ist in Luzern Pflicht. Unsere Fahrer sprechen Deutsch, Englisch, oft Französisch und Italienisch. Das schätzen besonders Gäste aus dem Ausland."}],["$","p","1",{"children":"Unsere Fahrzeuge sind sauber, klimatisiert und mit Platz für mehrere Koffer ausgestattet. Auch grössere Reisegruppen können wir mit Minivans bedienen. Bezahlung erfolgt unkompliziert mit Bargeld, Karte oder Twint."}]]}]]}],"$L8","$L9"]
