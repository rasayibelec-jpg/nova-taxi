5:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was Steinhauser Familien schätzen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Sicherheit steht an erster Stelle. Unsere Fahrer sind alle mit Familien-Erfahrung und können auf Wunsch Kindersitze stellen. Wir fahren ruhig, vorausschauend und mit angepasster Geschwindigkeit."}],["$","p","1",{"children":"Stammkunden schätzen unsere Kontinuität: Oft werden Sie über die Jahre vom selben Fahrer gefahren. Das schafft Vertrauen und Komfort, besonders bei Kindern."}]]}]]}]
