7:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Zuger Gäste Nova Taxi wählen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Diskretion ist in einem Geschäftsstandort wie Zug essenziell. Wir geben keine Kundeninformationen weiter, fahren in dezenten dunklen Wagen und treten in höflicher Geschäftsgarderobe auf."}],["$","p","1",{"children":"Mehrsprachigkeit gehört zum Standard. Englisch wird von allen unseren Fahrern beherrscht, oft auch Italienisch, Französisch oder Russisch. Internationale Gäste fühlen sich verstanden."}]]}]]}]
