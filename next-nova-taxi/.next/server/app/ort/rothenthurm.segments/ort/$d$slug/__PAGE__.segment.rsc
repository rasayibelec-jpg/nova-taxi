4:[["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Taxi in Rothenthurm – auf 920 Metern zuverlässig"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Rothenthurm liegt auf rund 920 Metern Höhe und ist berühmt für sein einmaliges Hochmoorgebiet, das unter Bundesschutz steht. Im Winter wird der Ort zum kleinen Skiparadies, im Sommer kommen Wanderer und Ornithologen. Nova Taxi sorgt für Mobilität bei Wind und Wetter."}],["$","p","1",{"children":"Unsere Fahrer kennen die Strasse zwischen Sattel, Biberbrugg und Einsiedeln genau. Auch in den Quartieren Schornen, Altmatt und Biberbrugg sind wir täglich unterwegs."}]]}]]}],["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was wir in Rothenthurm bieten"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Skifahrer und Snowboarder, die im kleinen Skigebiet Rothenthurm-Sattel auf der Piste sind, nutzen uns für die Heimfahrt nach Schwyz, Zug oder Einsiedeln. Auch Familien, die mit Schlitten unterwegs sind, fahren wir gerne."}],["$","p","1",{"children":"Im Sommer sind die Hochmoor-Wanderwege ein beliebtes Ziel. Wir holen Wanderer am Bahnhof Rothenthurm ab und bringen sie zu Ausgangspunkten oder Hütten. Ornithologen schätzen die ruhige Anfahrt zu den Beobachtungsposten."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Skigebiet Rothenthurm-Sattel"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hochmoorgebiet – Wanderausgangspunkte"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Rothenthurm – Voralpen-Express"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 60 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Sattel-Hochstuckli mit Drehgondel"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schlittentransfer und Ausrüstungstransport"}]]}]]}]]}],["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Rothenthurmer Nova Taxi wählen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Wir sind auch bei Schneefall und Glatteis zuverlässig. Unsere Fahrzeuge tragen Winterreifen mit Schweizer Sicherheitssiegel, und unsere Fahrer sind im Wintertraining geschult. Sie bringen uns sicher selbst durch tiefen Schnee."}],["$","p","1",{"children":"Für Senioren bieten wir besondere Sorgfalt: Wir helfen beim Einsteigen, transportieren Rollatoren und fahren mit angepasster Geschwindigkeit. Auch Tierarzt-Fahrten mit Hunden oder Katzen sind kein Problem."}]]}]]}],"$L8","$L9"]
