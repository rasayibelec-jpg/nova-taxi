6:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Weggiser Gäste uns wählen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Wir sind als Service-Partner mehrerer lokaler Hotels bekannt. Unsere Diskretion, Pünktlichkeit und das einwandfreie Auftreten entsprechen dem Niveau der Häuser."}],["$","p","1",{"children":"Auch Privatkunden geniessen diese Standards. Stammkunden erreichen uns über persönliche Telefonnummern und können mit individuellen Tarifen rechnen."}]]}]]}]
