{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/ort/layout,_N_T_/ort/[slug]/layout,_N_T_/ort/[slug]/page,_N_T_/ort/rothenburg"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/ort/$d$slug/__PAGE__",
    "/ort/$d$slug",
    "/ort",
    "/_index",
    "/_head"
  ]
}