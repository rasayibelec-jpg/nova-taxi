me":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Senioren- und Krankentransporte"}]]}]]}]]}]
5:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Warum Walchwiler auf uns setzen"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Wir kennen die Strassenverhältnisse rund um Walchwil. Bei Steinschlag oder Sperrungen finden wir Alternativrouten über Arth-Goldau oder Zug."}],["$","p","1",{"children":"Stammkunden erreichen uns über persönliche Telefonnummern. Sie sprechen mit Fahrern, die Sie kennen und Ihre Vorlieben respektieren."}]]}]]}]
