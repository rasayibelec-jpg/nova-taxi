1a:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Horw liegt am südwestlichen Ufer des Vierwaldstättersees und ist Heimat der Hochschule Luzern – Technik & Architektur (HSLU). Studierende, Dozierende und Pendler bilden das Rückgrat der lokalen Mobilität. Nova Taxi unterstützt sie täglich."}],["$","p","1",{"children":"Wir bedienen sowohl den Campus Horw als auch die Wohnquartiere wie Stutz, Spannort und Kastanienbaum. Auch zur Schiffsanlegestelle Kastanienbaum-Hermitage bringen wir Sie zuverlässig."}]]}]
1b:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was wir in Horw leisten"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Studenten der HSLU schätzen unsere fairen Preise für späte Heimfahrten oder Flughafentransfers. Wir bieten Studentenrabatte gegen Vorzeigen der Legi, sofern wir das im Voraus vereinbaren."}],["$","p","1",{"children":"Familien nutzen uns für Ausflüge zur Kastanienbaum-Halbinsel oder ins Hermitage-Restaurant. Pendler fahren mit uns morgens nach Luzern oder zur HSLU, wenn der Bus zu langsam ist."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"HSLU Campus Horw – Direktanfahrt"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Horw – Abholung am Gleis"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schiffsanleger Kastanienbaum"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 55 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Studentenrabatte bei Vorzeigen der Legi"}]]}],["$","li","5",{"cla