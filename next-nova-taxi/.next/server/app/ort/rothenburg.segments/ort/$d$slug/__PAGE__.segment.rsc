4:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Rothenburg liegt nördlich von Luzern und vereint dörflichen Charakter mit guter Verkehrsanbindung. Pendler, Familien und Senioren sind unsere Hauptkunden. Nova Taxi ist regelmässig auf der Hauptstrasse und in den Quartieren Bertiswil und Hellbühl unterwegs."}],["$","p","1",{"children":"Wir kennen die Eigenheiten der Region – etwa die Schulwegzeiten, den morgendlichen Berufsverkehr Richtung Emmen-Luzern oder die abendliche Heimkehr nach Rothenburg."}]]}]
5:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Unsere Leistungen in Rothenburg"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Senioren nutzen uns für Arzttermine, Spitalbesuche im LUKS Luzern oder Therapietermine. Familien für Schulwege oder Wochenendausflüge. Geschäftsleute für Flughafentransfers und Hotelfahrten."}],["$","p","1",{"children":"Auch Veranstaltungen wie das Rothenburger Dorffest oder Hochzeiten in der Pfarrkirche werden von uns mit Shuttle-Diensten unterstützt."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Rothenburg – Abholung am Gleis"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"LUKS Luzern – Krankentransporte"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 55 Minuten"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schulwege und Senioren-Transfers"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hochzeits- und Eventfahrten"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-