3:["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Baar ist die zweitgrösste Gemeinde im Kanton Zug und ein wichtiger Wirtschaftsstandort. Hier finden sich grosse Unternehmen wie Glencore, V-Zug und zahlreiche Tech-Firmen. Nova Taxi ist täglich in Baar unterwegs und bedient sowohl Geschäftskunden als auch Privatpersonen."}],["$","p","1",{"children":"Wir kennen das Hauserareal, die Industriezone Sennweid und die Wohnquartiere Inwil und Allenwinden. Unsere Fahrer wissen, wo morgens der Verkehr stockt und welche Schleichwege Sie schneller ans Ziel bringen."}]]}]
4:["$","section",null,{"className":"rounded-2xl bg-white/5 border border-white/10 p-6 md:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was wir in Baar anbieten"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4 mb-6","children":[["$","p","0",{"children":"Geschäftskunden bei Glencore, V-Zug oder anderen Firmen buchen uns regelmässig für Termine, Flughafenfahrten und Hotel-Shuttle-Services. Wir bieten Festpreise und Monatsabrechnungen an."}],["$","p","1",{"children":"Familien aus Baar nutzen uns für Schultransporte, Arztbesuche oder Wochenendausflüge. Auch zur Mall of Switzerland oder ins KKL Luzern bringen wir Sie zuverlässig."}]]}],["$","ul",null,{"className":"grid md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Bahnhof Baar – Abholung am Gleis"}]]}],["$","li","1",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Glencore und V-Zug Hauptsitze"}]]}],["$","li","2",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Hauserareal und Industriezone Sennweid"}]]}],["$","li","3",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Flughafentransfer Zürich – ca. 35 Minuten"}]]}],["$","li","4",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Mall of Switzerland Ebikon"}]]}],["$","li","5",{"className":"flex items-start gap-3 text-gray-200","children":[["$","span",null,{"className":"mt-1 h-2 w-2 rounded-full bg-nova-gold flex-shrink-0"}],["$","span",null,{"children":"Schulwege und Senioren-Transfer"}]]}]]}]]}]
5:["$","section",null,{"className":"prose prose-invert max-w-none","children":[["$","h2",null,{"className":"text-2xl font-semibold text-white mb-4","children":"Was Baarer Kunden überzeugt"}],["$","div",null,{"className":"text-gray-300 leading-relaxed space-y-4","children":[["$","p","0",{"children":"Wir sind verlässlich, freundlich und kostentransparent. Bei Vorausbuchung garantieren wir Festpreise. Geschäftskunden erhalten monatliche Abrechnungen mit detaillierter Auflistung jeder Fahrt."}],["$","p","1",{"children":"Unsere Fahrzeuge sind sauber, klimatisiert und mit Platz für Geschäftsgepäck oder Familien-Gepäck. Bezahlung erfolgt mit allen gängigen Methoden."}]]}]]}]
